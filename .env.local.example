# Copy this file to .env.local and fill in real values. .env.local is
# gitignored by default in a Next.js app - never commit real secrets.

# Shared password for the whole site (share this with your book club).
SITE_PASSWORD=

# Random long string used to sign the login session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# From your Supabase project: Settings > Data API.
SUPABASE_URL=
# Settings > API Keys > service_role (secret - server-only, never exposed
# to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Book lookup uses Open Library by default, which needs no key.
# Set this to prefer Google Books instead (better metadata, but its keyless
# quota is permanently exhausted, so a key is required for it to work at
# all). Get one at https://console.cloud.google.com/apis/credentials with
# the "Books API" enabled. Falls back to Open Library if the call fails.
GOOGLE_BOOKS_API_KEY=
